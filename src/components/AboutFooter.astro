---
type Props = {
  page: "home" | "gallery";
};

const { page } = Astro.props;
---

<footer id="about" class:list={["sonia-footer", { "sonia-footer-home": page === "home" }]}>
  <div class="sonia-footer-content">
    {page === "home" && (
      <>
        <p>Ruby Smythe is a New Zealand-born painter and tattoo artist based in Edinburgh.</p>
        <a href="#about">About Ruby</a>
      </>
    )}
  </div>
  {page === "gallery" && (
    <div class="sonia-mobile-footer" aria-label="Site information">
      <span>Ruby Smythe, Edinburgh</span>
      <a href="https://www.instagram.com/byrubydesigns" target="_blank" rel="noreferrer">Instagram</a>
    </div>
  )}
</footer>
