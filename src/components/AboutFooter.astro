---
import { Image } from "astro:assets";
import contactPhoto from "../assets/artwork/contact/IMG_1155.webp";
import studioPhoto from "../assets/artwork/tattoo/IMG_2233.webp";
---

<footer id="about" class="wall-about" aria-labelledby="about-heading">
  <div class="wall-about-photos">
    <Image
      src={contactPhoto}
      alt="Ruby painting beside a bouquet of flowers"
      widths={[240, 480, 640]}
      sizes="(max-width: 767px) 44vw, 22vw"
      quality={88}
      loading="lazy"
    />
    <Image
      src={studioPhoto}
      alt="Sunlight across Inkdependent Studio in Edinburgh"
      widths={[240, 480, 640]}
      sizes="(max-width: 767px) 44vw, 22vw"
      quality={88}
      loading="lazy"
    />
  </div>
  <div>
    <h2 id="about-heading">Hi, I'm Ruby</h2>
    <p>
      New Zealand-born painter and tattoo artist in Edinburgh. Custom work and
      flash bookings via Instagram.
    </p>
    <p class="wall-about-studio">Inkdependent Studio, Haymarket</p>
    <a
      class="wall-about-cta"
      href="https://www.instagram.com/byrubydesigns"
      target="_blank"
      rel="noopener noreferrer">Message @byrubydesigns</a
    >
  </div>
</footer>
