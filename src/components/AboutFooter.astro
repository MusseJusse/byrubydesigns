---
type Props = {
  page: "home" | "gallery";
};

const { page } = Astro.props;
---

<footer id="about" class:list={["sonia-footer", { "sonia-footer-home": page === "home" }]}>
  <div class="sonia-footer-content">
    <p>Ruby Smythe is a New Zealand-born painter and tattoo artist based in Edinburgh.</p>
    <div class="sonia-footer-links" aria-label="External links">
      <a href="https://www.instagram.com/byrubydesigns" target="_blank" rel="noreferrer">
        Instagram
      </a>
      <a href="https://inkdependent.eu/" target="_blank" rel="noreferrer">
        Inkdependent Studio
      </a>
    </div>
  </div>
  <div class="sonia-mobile-footer" aria-label="Site information">
    <span>{page === "gallery" ? "Ruby Smythe, Edinburgh" : "Instagram"}</span>
    {
      page === "gallery" ? (
        <a href="https://www.instagram.com/byrubydesigns" target="_blank" rel="noreferrer">Instagram</a>
      ) : (
        <span>Edinburgh</span>
      )
    }
  </div>
</footer>
