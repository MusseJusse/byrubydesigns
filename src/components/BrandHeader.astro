---
import { Image } from "astro:assets";
import rubyMark from "../assets/brand/ruby-mark.webp";
import { galleryCategories } from "../data/artwork";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  page: "home" | "gallery";
};

const { page } = Astro.props;
---

<header class:list={["editorial-header", { "editorial-header-gallery": page === "gallery" }]}>
  <a class="editorial-brand" href="/" aria-label="Ruby Smythe, home">
    <Image class="editorial-brand-image" src={rubyMark} width={62} alt="" loading="eager" />
    <strong>ruby smythe</strong>
    <span>tattoo, drawing &amp; painting</span>
  </a>

  <nav class="editorial-main-nav" aria-label="Primary navigation">
    {page === "gallery" && <a href="/">Home</a>}
    <a class:list={[{ active: page === "gallery" }]} href="/gallery">Work</a>
    <a href="#about">About</a>
    <ThemeToggle class="editorial-theme-toggle-desktop" />
    <a
      class="editorial-book-link"
      href="https://www.instagram.com/byrubydesigns"
      target="_blank"
      rel="noreferrer"
    >Book</a>
  </nav>

  <div class="editorial-mobile-actions">
    <ThemeToggle class="editorial-theme-toggle-mobile" />
    <a
      class="editorial-mobile-book"
      href="https://www.instagram.com/byrubydesigns"
      target="_blank"
      rel="noreferrer"
    >Book</a>
  </div>
</header>

{
  page === "gallery" && (
    <nav class="editorial-category-nav" aria-label="Portfolio sections">
      {galleryCategories.map((category) => (
        <button
          class={category.id === "tattoo" ? "active" : undefined}
          type="button"
          data-category-trigger={category.id}
          aria-controls={"gallery-" + category.id}
          aria-pressed={category.id === "tattoo" ? "true" : "false"}
        >
          {category.label}
        </button>
      ))}
    </nav>
  )
}
