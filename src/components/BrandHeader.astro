---
import { Image } from "astro:assets";
import rubyMark from "../assets/brand/ruby-mark.webp";
import { galleryCategories } from "../data/artwork";
---

<header class="sonia-header" aria-label="Primary">
  <button
    class="sonia-menu-button"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="sonia-mobile-menu"
    data-menu-button
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>

  <div class="sonia-brand">
    <a class="sonia-brand-mark" href="#top" aria-label="Ruby Smythe, back to top">
      <span class="sonia-brand-image">
        <Image src={rubyMark} width={180} alt="" loading="eager" />
      </span>
      <span class="sonia-brand-name">ruby smythe</span>
      <span class="sonia-brand-subtitle">tattoo, painting &amp; drawing</span>
    </a>

    <nav class="sonia-main-nav" aria-label="Portfolio sections">
      {
        galleryCategories.map((category) => (
          <button
            class={category.id === "tattoo" ? "active" : undefined}
            type="button"
            data-category-trigger={category.id}
            aria-controls={"gallery-" + category.id}
            aria-pressed={category.id === "tattoo" ? "true" : "false"}
          >
            {category.label}
          </button>
        ))
      }
      <a href="#about">About</a>
    </nav>
  </div>

  <div
    id="sonia-mobile-menu"
    class="sonia-mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="Site menu"
    data-mobile-menu
  >
    <nav class="sonia-mobile-nav" aria-label="Portfolio sections">
      {
        galleryCategories.map((category) => (
          <button
            class={category.id === "tattoo" ? "active" : undefined}
            type="button"
            tabindex="-1"
            data-category-trigger={category.id}
            aria-controls={"gallery-" + category.id}
            aria-pressed={category.id === "tattoo" ? "true" : "false"}
          >
            {category.label}
          </button>
        ))
      }
      <a href="#about" tabindex="-1" data-menu-close>About</a>
    </nav>
  </div>
</header>
