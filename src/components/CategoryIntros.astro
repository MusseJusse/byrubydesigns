---
import { galleryCategories } from "../data/artwork";

interface Props {
  className: string;
}

const { className } = Astro.props;
---

<div class:list={["category-intros", className]}>
  {
    galleryCategories.map((category) => (
      <div
        class="category-intro"
        data-category-intro={category.id}
      >
        {category.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    ))
  }
</div>
