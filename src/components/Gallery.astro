---
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";
import { galleryCategories, type GalleryArtwork } from "../data/artwork";
import paintingTable from "../assets/artwork/contact/painting-table.webp";

const images = import.meta.glob<ImageMetadata>(
  "/src/assets/artwork/**/*.webp",
  { eager: true, import: "default" },
);
const selectedPaths = [
  "/src/assets/artwork/tattoo/IMG_1163.webp",
  "/src/assets/artwork/paintings/painting-02.webp",
  "/src/assets/artwork/tattoo/IMG_6601.webp",
];

const artwork = galleryCategories.flatMap((category) =>
  category.items.map((item: GalleryArtwork) => {
    const image = images[item.imagePath];
    if (!image) throw new Error("Artwork file is missing: " + item.imagePath);
    return {
      ...item,
      image,
      category: category.id,
      caption:
        item.caption ??
        (category.id === "paintings"
          ? `Painting, ${item.year}`
          : category.id === "drawings"
            ? "Ballpoint pen"
            : "Tattoo"),
      selected: selectedPaths.includes(item.imagePath),
    };
  }),
);
const selected = selectedPaths.map((path) => {
  const item = artwork.find((candidate) => candidate.imagePath === path);
  if (!item) throw new Error("Selected artwork is missing: " + path);
  return item;
});
const items = await Promise.all(
  [
    ...selected,
    {
      title: "At the painting table",
      image: paintingTable,
      category: "studio",
      caption: "Studio photograph",
      selected: true,
      medium: undefined,
      year: undefined,
      dimensions: undefined,
    },
    ...artwork.filter((item) => !item.selected),
  ].map(async (item) => {
    const lightboxWidth = Math.min(1600, item.image.width);
    return {
      ...item,
      lightboxWidth,
      lightboxHeight: Math.round(
        (lightboxWidth * item.image.height) / item.image.width,
      ),
      lightbox: await getImage({
        src: item.image,
        width: lightboxWidth,
        format: "webp",
        quality: 80,
      }),
    };
  }),
);
const filters = [
  {
    id: "selected",
    label: "Favourites",
    count: selected.length + 1,
    status: `${selected.length + 1} favourites`,
    intro: ["A few favourites: tattoos, paintings, and work in progress."],
  },
  ...["tattoo", "paintings", "drawings"].map((id) => {
    const category = galleryCategories.find((category) => category.id === id);
    if (!category) throw new Error("Gallery category is missing: " + id);
    return {
      id,
      label: category.label,
      count: category.items.length,
      status: `${category.items.length} ${category.label.toLowerCase()}`,
      intro: category.intro,
    };
  }),
];
---

<section
  id="work"
  class="collection-content"
  aria-label="Artwork"
  tabindex="-1"
>
  <div class="filter-controls" role="group" aria-label="Filter artwork">
    <span class="filter-indicator" data-filter-indicator aria-hidden="true"
    ></span>
    {
      filters.map((filter) => (
        <>
          <input
            type="radio"
            name="artwork-filter"
            id={`filter-${filter.id}`}
            value={filter.id}
            checked={filter.id === "selected"}
            aria-controls="artwork-grid"
          />
          <label for={`filter-${filter.id}`}>
            {filter.label}
            <span class="filter-count">{filter.count}</span>
          </label>
        </>
      ))
    }
  </div>
  <p
    class="collection-count"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    {filters.map((filter) => <span data-count={filter.id}>{filter.status}</span>)}
  </p>
  <div class="collection-wall">
    <div class="category-intros">
      {
        filters.map((filter) => (
          <div class="category-intro" data-category-intro={filter.id}>
            {filter.intro.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        ))
      }
    </div>
    <div id="artwork-grid" class="collection-grid">
      {
        items.map((item, index) => {
          // Paintings show their medium and year; everything else keeps its caption.
          const meta = item.medium
            ? [item.medium, item.year].filter(Boolean).join(", ")
            : item.caption;
          const dimensions = item.dimensions
            ? // Numbers stay together. At large text the unit can wrap on its own.
              `${item.dimensions.width}\u00a0×\u00a0${item.dimensions.height} ${item.dimensions.unit}`
            : undefined;
          return (
            <figure
              data-category={item.category}
              data-selected={item.selected ? "true" : undefined}
              style={`--ratio: ${(item.image.width / item.image.height).toFixed(4)}`}
            >
              <button
                type="button"
                data-lightbox-open
                data-full-src={item.lightbox.src}
                data-full-width={item.lightboxWidth}
                data-full-height={item.lightboxHeight}
                data-title={item.title}
                data-medium={meta}
                data-dimensions={dimensions}
                aria-label={`View full image of ${item.title}`}
              >
                <Image
                  src={item.image}
                  alt={`${item.title}, ${item.caption.toLowerCase()}, by Ruby Smythe`}
                  widths={[360, 720, 1080].filter(
                    (width) => width <= item.image.width,
                  )}
                  sizes={
                    item.selected
                      ? "(max-width: 767px) 50vw, 46vw"
                      : "(max-width: 767px) 50vw, 31vw"
                  }
                  quality={80}
                  loading={item.selected ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                />
              </button>
              <figcaption>
                <span class="artwork-title">{item.title}</span>
                {dimensions && <span class="artwork-size">{dimensions}</span>}
                <span class="artwork-meta">{meta}</span>
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>
</section>
