<div
  class="sonia-lightbox"
  data-lightbox
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Artwork viewer"
>
  <button class="sonia-lightbox-close" data-lightbox-close type="button" aria-label="Close full image">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </button>
  <button
    class="sonia-lightbox-arrow sonia-lightbox-previous"
    data-lightbox-previous
    type="button"
    aria-label="Show previous image"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="m15 4-8 8 8 8" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </button>
  <figure>
    <img data-lightbox-image alt="" />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
  <button
    class="sonia-lightbox-arrow sonia-lightbox-next"
    data-lightbox-next
    type="button"
    aria-label="Show next image"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="m9 4 8 8-8 8" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </button>
</div>
