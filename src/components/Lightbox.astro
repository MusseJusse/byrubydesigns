<dialog
  class="lightbox"
  data-lightbox
  aria-label="Artwork viewer"
  tabindex="-1"
>
  <button
    class="lightbox-close"
    data-lightbox-close
    type="button"
    aria-label="Close full image"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.5"
      ></path>
    </svg>
  </button>
  <p class="lightbox-count" data-lightbox-count aria-hidden="true"></p>
  <button
    class="lightbox-arrow lightbox-previous"
    data-lightbox-previous
    type="button"
    aria-label="Show previous image"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="m15 4-8 8 8 8" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </button>
  <figure>
    <div class="lightbox-image-stage" data-lightbox-stage>
      <div class="lightbox-fit" data-lightbox-fit>
        <div class="lightbox-zoom" data-lightbox-zoom>
          <img data-lightbox-image alt="" decoding="async" />
        </div>
      </div>
    </div>
    <figcaption data-lightbox-caption aria-live="polite"></figcaption>
  </figure>
  <button
    class="lightbox-arrow lightbox-next"
    data-lightbox-next
    type="button"
    aria-label="Show next image"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="m9 4 8 8-8 8" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </button>
  <div
    class="lightbox-rail"
    data-lightbox-rail
    role="group"
    aria-label="Artwork set"
  >
  </div>
</dialog>
