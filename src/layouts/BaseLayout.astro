---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import fontUrl from "../assets/fonts/tiktok-sans-latin.woff2?url";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const site = Astro.site ?? new URL("https://www.byrubydesigns.com");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL("/og.jpg", site).href;
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ruby Smythe",
  alternateName: "byrubydesigns",
  url: "https://www.byrubydesigns.com/",
  jobTitle: "Tattoo artist and painter",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Edinburgh",
    addressCountry: "GB"
  },
  sameAs: ["https://www.instagram.com/byrubydesigns"]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="byrubydesigns" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Pink water lily painting by Ruby Smythe"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Pink water lily painting by Ruby Smythe"
    />
    <meta name="theme-color" content="#e8e8e5" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
