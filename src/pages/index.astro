---
import { Image } from "astro:assets";
import AboutFooter from "../components/AboutFooter.astro";
import BrandHeader from "../components/BrandHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import landingImage from "../assets/artwork/landing/1000389578.webp";
import painting from "../assets/artwork/paintings/painting-03.webp";
import leadTattoo from "../assets/artwork/tattoo/1 floral forearm piece.webp";
---

<BaseLayout
  title="Ruby Smythe | Tattoo artist and painter in Edinburgh"
  description="Tattoo, painting, and drawing work by New Zealand-born artist Ruby Smythe in Edinburgh."
>
  <main id="top" class="portfolio-root editorial-home">
    <BrandHeader page="home" />

    <section class="editorial-home-grid" aria-labelledby="home-title">
      <figure class="editorial-home-image editorial-home-image-lead">
        <Image
          src={leadTattoo}
          alt="Floral forearm tattoo by Ruby Smythe"
          widths={[540, 760, 980]}
          sizes="(max-width: 640px) 61vw, 30vw"
          quality={88}
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <figure class="editorial-home-image editorial-home-image-painting">
        <Image
          src={painting}
          alt="Peony painting by Ruby Smythe"
          widths={[360, 540, 760]}
          sizes="(max-width: 640px) 39vw, 44vw"
          quality={88}
          loading="eager"
        />
      </figure>

      <figure class="editorial-home-image editorial-home-image-feature">
        <Image
          src={landingImage}
          alt="Botanical painting in progress by Ruby Smythe"
          widths={[420, 640, 860]}
          sizes="(max-width: 640px) 100vw, 26vw"
          quality={88}
          loading="eager"
        />
        <figcaption>
          <span>Painting in progress</span>
          <span>Watercolour and botanical studies</span>
        </figcaption>
      </figure>

      <div class="editorial-home-message">
        <h1 id="home-title">Ruby Smythe. <span>Skin &amp; paper.</span></h1>
        <div class="editorial-home-message-bottom">
          <p>Fine-line tattoos, drawings and paintings by Ruby Smythe in Edinburgh.</p>
          <a href="/gallery">Explore the work</a>
        </div>
      </div>
    </section>

    <section class="editorial-home-about" aria-label="About Ruby">
      <p>Ruby is a New Zealand-born painter and tattoo artist working at Inkdependent Studio near Haymarket.</p>
      <a href="#about">About Ruby</a>
    </section>

    <AboutFooter page="home" />
  </main>
</BaseLayout>
