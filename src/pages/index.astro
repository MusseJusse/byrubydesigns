---
import { Image } from "astro:assets";
import AboutFooter from "../components/AboutFooter.astro";
import BrandHeader from "../components/BrandHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import tattoo13 from "../assets/artwork/tattoo/IMG_6601.webp";
import painting01 from "../assets/artwork/paintings/painting-01.webp";
import tattoo12 from "../assets/artwork/tattoo/IMG_3554.webp";
import painting02 from "../assets/artwork/paintings/painting-02.webp";
import kereru from "../assets/artwork/tattoo/7 kererū.webp";
import contactPhoto from "../assets/artwork/contact/IMG_1155.webp";

const carouselItems = [
  { image: tattoo13, title: "Tattoo 13" },
  { image: painting01, title: "Painting 01" },
  { image: tattoo12, title: "Tattoo 12" },
  { image: painting02, title: "Painting 02" },
  { image: kereru, title: "Kererū" }
];
const initialCount = `01 / ${String(carouselItems.length).padStart(2, "0")}`;
---

<BaseLayout
  title="Ruby Smythe | Tattoo artist and painter in Edinburgh"
  description="Tattoo, painting, and drawing work by New Zealand-born artist Ruby Smythe in Edinburgh."
>
  <main id="top" class="portfolio-root">
    <BrandHeader page="home" />

    <section class="landing-carousel" aria-label="Selected artwork">
      <div class="landing-intro">
        <h1>Selected work</h1>
        <p class="landing-title" aria-live="polite" data-carousel-title>
          {carouselItems[0].title}
        </p>
        <Image
          class="contact-photo"
          src={contactPhoto}
          alt="Ruby Smythe painting at a table beside a bouquet of flowers"
          widths={[320, 480, 640]}
          sizes="(min-width: 900px) min(32vw, 380px), 0px"
          quality={88}
          loading="lazy"
        />
      </div>
      <div class="art-carousel">
        <div class="carousel-heading">
          <h1>Highlighted pieces</h1>
          <span data-carousel-count>{initialCount}</span>
        </div>
        <div
          class="carousel-stage"
          style={`--carousel-aspect-ratio: ${carouselItems[0].image.width} / ${carouselItems[0].image.height}`}
        >
          <ol class="carousel-slides">
            {
              carouselItems.map((item, index) => (
                <li
                  class="carousel-slide"
                  data-carousel-slide
                  style={`opacity: ${index === 0 ? 1 : 0}; transform: scale(${index === 0 ? 1 : 0.985})`}
                >
                  <Image
                    src={item.image}
                    alt={`${item.title}, artwork by Ruby Smythe`}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(max-width: 640px) 92vw, (max-width: 899px) 504px, (max-width: 1280px) 58vw, 700px"
                    quality={88}
                    loading={index < 2 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                </li>
              ))
            }
          </ol>
          <div
            class="carousel-drag"
            role="group"
            tabindex="0"
            aria-label="Selected tattoos and paintings. Swipe, drag, or use arrow keys to browse."
            data-carousel-track
          >
            {carouselItems.map(() => <span class="carousel-stop"></span>)}
          </div>
        </div>
        <div class="carousel-under">
          <p class="carousel-mobile-title" aria-live="polite" data-carousel-title>
            {carouselItems[0].title}
          </p>
          <p class="carousel-desktop-label">
            <span>Highlighted pieces</span>
            <span data-carousel-count>{initialCount}</span>
          </p>
          <div class="carousel-tools">
            <div class="carousel-markers" aria-label="Choose artwork">
              {
                carouselItems.map((item, index) => (
                  <button
                    aria-current={index === 0 ? "true" : undefined}
                    aria-label={`Show ${item.title}`}
                    class="carousel-marker"
                    style={`flex-grow: ${index === 0 ? 4 : 1}; background-color: rgba(144, 52, 76, ${index === 0 ? 1 : 0.22})`}
                    type="button"
                    data-carousel-marker
                    data-carousel-title={item.title}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <AboutFooter />
  </main>
</BaseLayout>

<script>
  import "../scripts/landing";
</script>
